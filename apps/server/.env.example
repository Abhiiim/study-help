APP_NAME="Study Saver API"
ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/study_saver"

JWT_SECRET_KEY="replace-with-a-long-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
FRONTEND_OAUTH_CALLBACK_URL="http://localhost:5173/oauth/callback"
ALLOWED_EXTENSION_REDIRECT_ORIGINS='["https://<extension-id>.chromiumapp.org"]'

REFRESH_COOKIE_NAME="study_saver_refresh"
OAUTH_STATE_COOKIE_NAME="study_saver_oauth_state"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""

# JSON array format
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'
